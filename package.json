{
  "name": "task-scheduler",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": ">=18.0.0" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
