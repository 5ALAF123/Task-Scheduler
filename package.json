{
  "name": "task-scheduler",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": ">=23.4.0" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.cjs\" \"vite\"",
    "dev:server": "node --watch server/index.cjs",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.0",
    "vite": "^8.2.0"
  }
}
